<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= tour.name %> | Go Cape Tours</title>

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <style>
    #map {
      height: 500px;
      width: 100%;
      border-radius: 12px;
      margin-top: 1rem;
    }
  </style>
</head>
<body>
  <h1><%= tour.name %></h1>
  <p><%= tour.description %></p>

  <div id="map"></div>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script>
    const stops = <%- JSON.stringify(tour.stops) %>;

    if (stops.length) {
      const map = L.map('map').setView([stops[0].lat, stops[0].lng], 10);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      const bounds = [];

      stops.forEach(stop => {
        const marker = L.marker([stop.lat, stop.lng]).addTo(map);
        marker.bindPopup(`<b>${stop.name}</b><br>${stop.description || ''}`);
        bounds.push([stop.lat, stop.lng]);
      });

      if (bounds.length > 1) map.fitBounds(bounds);
    } else {
      document.getElementById('map').innerHTML = 'No stops available for this tour.';
    }
  </script>
</body>
</html>
